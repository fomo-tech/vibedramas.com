# Application
# Copy this file to .env.local and replace the required values.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
HOSTNAME=0.0.0.0

# Database and cache (required)
MONGODB_URI=mongodb://localhost:27017/vibe-drama
REDIS_URL=redis://localhost:6379

# Authentication (required; generate with: openssl rand -hex 32)
JWT_SECRET=

# Google OAuth (optional; required only for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to APP_URL/api/auth/google/callback when omitted.
GOOGLE_REDIRECT_URI=

# Scheduled jobs (required when cron endpoints are enabled)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Cloudinary (optional; required for chat image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# MoMo payments (optional; required when MoMo top-up is enabled)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Bank transfer / VietQR (optional; required for bank top-up details)
TOPUP_BANK_ACCOUNT_NUMBER=
TOPUP_BANK_ACCOUNT_NAME=
TOPUP_BANK_NAME=
TOPUP_BANK_CODE=
SEPAY_API_KEY=

# Analytics and site verification (optional, exposed to the browser)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# DramaWave crawler (optional)
DRAMAWAVE_ENCRYPTION_BUNDLE_URL=
DRAMAWAVE_API_PRIVATE_KEY=
DRAMAWAVE_USE_CURL=0
